# ─── Sanity CMS ──────────────────────────────────────────────────────────
# Values come from the college-owned Sanity project (manage.sanity.io).
# Copy this file to .env.local and fill in the real values. Do NOT commit .env.local.

# Found under Project settings → API in the Sanity dashboard:
NEXT_PUBLIC_SANITY_PROJECT_ID=your_project_id
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-01-01

# Server-only token (Editor/Viewer) for on-demand revalidation & drafts.
# Create under Project settings → API → Tokens. Never expose to the browser.
SANITY_API_READ_TOKEN=your_read_token

# Shared secret you invent; also set it on the Sanity webhook (Phase: revalidation).
SANITY_REVALIDATE_SECRET=some_long_random_string
